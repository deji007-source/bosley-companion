# Required: generate a unique long random value. Keep it server-side.
LITELLM_MASTER_KEY=sk-bosley-replace-with-a-long-random-secret

# Optional cloud fallbacks. Leave blank to use local Ollama only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# After deploying this stack behind HTTPS, configure these as Supabase Edge Function secrets:
# LITELLM_BASE_URL=https://your-private-gateway.example.com
# LITELLM_MASTER_KEY=<same value as above>
